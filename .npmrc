# Dependency registry for this project.
# Adopt Chainguard Libraries via our JFrog virtual repo. Token via ${JFROG_TOKEN} env (never committed).
registry=https://chainguardlibraries.jfrog.io/artifactory/api/npm/andrewgc-jscript/
//chainguardlibraries.jfrog.io/artifactory/api/npm/andrewgc-jscript/:_authToken=${JFROG_TOKEN}
always-auth=true
